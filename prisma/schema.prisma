// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Severity {
  MAJOR
  MINOR
  PATCH
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  passwordHash String
  name         String?
  createdAt    DateTime      @default(now())
  deployEntries DeployEntry[]
}

model DeployEntry {
  id          String   @id @default(cuid())
  title       String
  description String
  severity    Severity
  createdAt   DateTime @default(now())
  authorId    String
  author      User     @relation(fields: [authorId], references: [id])
}

enum ActivityAction {
  CREATED
  DELETED
}

// Deliberately not a foreign-key relation to DeployEntry: this is an audit
// trail, so a record needs to survive the entry it describes being deleted.
// Actor/entry details are captured as plain fields at the time of the action.
model ActivityLog {
  id         String         @id @default(cuid())
  action     ActivityAction
  entryTitle String
  severity   Severity
  actorName  String?
  actorEmail String
  createdAt  DateTime       @default(now())
}
